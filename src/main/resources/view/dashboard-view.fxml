<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ejemplo.crudpersona.controller.DashboardController"
            fitToWidth="true" styleClass="pagina-scroll">

    <VBox styleClass="pagina,dashboard-moderno" spacing="22.0">
        <HBox styleClass="bienvenida-dashboard" alignment="CENTER_LEFT" spacing="20.0">
            <VBox spacing="9.0" HBox.hgrow="ALWAYS">
                <Label text="MINIMARKET PRO" styleClass="bienvenida-marca"/>
                <Label text="¡Bienvenido al minimarket!" styleClass="bienvenida-titulo" wrapText="true"/>
                <Label text="Administra tus ventas, productos e inventario desde un solo lugar." styleClass="bienvenida-subtitulo" wrapText="true"/>
                <HBox alignment="CENTER_LEFT"><Label text="Panel general de administración" styleClass="bienvenida-etiqueta"/></HBox>
            </VBox>
            <StackPane styleClass="bienvenida-icono"><FontIcon iconLiteral="fth-shopping-cart"/></StackPane>
        </HBox>

        <!-- ============ Cabecera ============ -->
        <HBox styleClass="pagina-cabecera">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Dashboard" styleClass="pagina-titulo"/>
                <Label fx:id="lblActualizado" text="Resumen general" styleClass="pagina-subtitulo"/>
            </VBox>
            <ComboBox fx:id="cmbPeriodo" prefWidth="170.0" styleClass="selector-periodo"/>
            <Button text="Exportar Excel" onAction="#onExportarExcel" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
            </Button>
            <Button text="Actualizar" onAction="#onActualizar" styleClass="button-outlined">
                <graphic><FontIcon fx:id="iconoActualizar" iconLiteral="fth-refresh-cw"/></graphic>
            </Button>
        </HBox>

        <!-- ============ Ventas: indicadores ============ -->
        <Label text="VENTAS" styleClass="dashboard-seccion"/>
        <GridPane hgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>

            <VBox styleClass="tarjeta,kpi,kpi-destacado" GridPane.columnIndex="0">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Total vendido" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-trending-up"/></StackPane>
                </HBox>
                <Label fx:id="kpiVentas" text="S/ 0.00" styleClass="kpi-valor"/>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label fx:id="kpiVentasVariacion" styleClass="variacion"/>
                    <Label fx:id="kpiVentasDetalle" text=" " styleClass="kpi-detalle"/>
                </HBox>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="1">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Comprobantes" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-file-text"/></StackPane>
                </HBox>
                <Label fx:id="kpiComprobantes" text="0" styleClass="kpi-valor"/>
                <Label fx:id="kpiComprobantesDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="2">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Ticket promedio" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-shopping-bag"/></StackPane>
                </HBox>
                <Label fx:id="kpiTicket" text="S/ 0.00" styleClass="kpi-valor"/>
                <Label fx:id="kpiTicketDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="3">
                <HBox styleClass="kpi-cabecera">
                    <Label text="IGV del periodo" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-percent"/></StackPane>
                </HBox>
                <Label fx:id="kpiIgv" text="S/ 0.00" styleClass="kpi-valor"/>
                <Label fx:id="kpiIgvDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>
        </GridPane>

        <!-- ============ Ventas: graficos y listas ============ -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="62.0"/>
                <ColumnConstraints percentWidth="38.0"/>
            </columnConstraints>

            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Evolución de ventas" styleClass="grafico-titulo"/>
                <Label fx:id="lblSerieSubtitulo" text="Total vendido por dia (S/)" styleClass="grafico-subtitulo"/>
                <AreaChart fx:id="graficoVentas" legendVisible="false" animated="false"
                           createSymbols="true" prefHeight="270.0" VBox.vgrow="ALWAYS" styleClass="grafico-area">
                    <xAxis><NumberAxis fx:id="ejeFechas" side="BOTTOM" minorTickVisible="false" forceZeroInRange="false"/></xAxis>
                    <yAxis><NumberAxis fx:id="ejeVentas" side="LEFT" minorTickVisible="false"/></yAxis>
                </AreaChart>
            </VBox>

            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Productos más vendidos" styleClass="grafico-titulo"/>
                <Label text="Top 5 por importe en el periodo" styleClass="grafico-subtitulo"/>
                <VBox fx:id="listaTopVendidos" styleClass="ranking" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Últimas ventas" styleClass="grafico-titulo"/>
                        <Label text="Imprime el comprobante en PDF con un clic" styleClass="grafico-subtitulo"/>
                    </VBox>
                    <Hyperlink text="Ver todas" onAction="#onVerVentas"/>
                </HBox>
                <VBox fx:id="listaUltimas" styleClass="lista-ventas"/>
            </VBox>

            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Mejores clientes" styleClass="grafico-titulo"/>
                <Label text="Top 5 por importe comprado en el periodo" styleClass="grafico-subtitulo"/>
                <VBox fx:id="listaClientes" styleClass="ranking" VBox.vgrow="ALWAYS"/>
            </VBox>
        </GridPane>

        <Label text="CATÁLOGO Y CLIENTES" styleClass="dashboard-seccion"/>

        <!-- ============ Indicadores ============ -->
        <GridPane fx:id="gridKpi" hgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="0">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Personas" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-users"/></StackPane>
                </HBox>
                <Label fx:id="kpiPersonas" text="0" styleClass="kpi-valor"/>
                <Label fx:id="kpiPersonasDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="1">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Categorías" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-tag"/></StackPane>
                </HBox>
                <Label fx:id="kpiCategorias" text="0" styleClass="kpi-valor"/>
                <Label fx:id="kpiCategoriasDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="2">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Productos" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-package"/></StackPane>
                </HBox>
                <Label fx:id="kpiProductos" text="0" styleClass="kpi-valor"/>
                <Label fx:id="kpiProductosDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>

            <VBox styleClass="tarjeta,kpi" GridPane.columnIndex="3">
                <HBox styleClass="kpi-cabecera">
                    <Label text="Valor del catálogo" styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <StackPane styleClass="kpi-icono"><FontIcon iconLiteral="fth-dollar-sign"/></StackPane>
                </HBox>
                <Label fx:id="kpiValor" text="S/ 0.00" styleClass="kpi-valor"/>
                <Label fx:id="kpiValorDetalle" text=" " styleClass="kpi-detalle"/>
            </VBox>
        </GridPane>

        <!-- ============ Graficos ============ -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0"/>
                <ColumnConstraints percentWidth="50.0"/>
            </columnConstraints>

            <!-- Distribucion por categoria (dona) -->
            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Productos por categoría" styleClass="grafico-titulo"/>
                <Label text="Participacion de cada categoria en el catalogo" styleClass="grafico-subtitulo"/>
                <HBox spacing="20.0" alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                    <StackPane fx:id="contenedorDona" prefWidth="240.0" prefHeight="240.0"
                               minWidth="200.0" minHeight="220.0">
                        <PieChart fx:id="graficoCategorias" legendVisible="false" labelsVisible="false"
                                  startAngle="90.0" clockwise="true" styleClass="dona"/>
                        <Circle fx:id="huecoDona" styleClass="dona-hueco" mouseTransparent="true"/>
                        <VBox alignment="CENTER" mouseTransparent="true">
                            <Label fx:id="lblTotalDona" text="0" styleClass="dona-total"/>
                            <Label text="productos" styleClass="dona-etiqueta"/>
                        </VBox>
                    </StackPane>
                    <VBox fx:id="leyendaDona" styleClass="leyenda" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Precio promedio por categoria -->
            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Precio promedio por categoria" styleClass="grafico-titulo"/>
                <Label text="Importe medio de los productos (S/)" styleClass="grafico-subtitulo"/>
                <BarChart fx:id="graficoPromedio" legendVisible="false" animated="false"
                          barGap="0.0" categoryGap="14.0" prefHeight="260.0" VBox.vgrow="ALWAYS"
                          styleClass="grafico-horizontal">
                    <xAxis><NumberAxis fx:id="ejePromedio" side="BOTTOM" minorTickVisible="false"/></xAxis>
                    <yAxis><CategoryAxis side="LEFT"/></yAxis>
                </BarChart>
            </VBox>

            <!-- Rangos de precio -->
            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Distribución de precios" styleClass="grafico-titulo"/>
                <Label text="Cantidad de productos por rango de precio (S/)" styleClass="grafico-subtitulo"/>
                <BarChart fx:id="graficoRangos" legendVisible="false" animated="false"
                          barGap="0.0" categoryGap="18.0" prefHeight="260.0" VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                    <yAxis><NumberAxis fx:id="ejeRangos" side="LEFT" minorTickVisible="false"/></yAxis>
                </BarChart>
            </VBox>

            <!-- Top 5 productos -->
            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="Productos de mayor precio" styleClass="grafico-titulo"/>
                <Label text="Top 5 del catalogo" styleClass="grafico-subtitulo"/>
                <VBox fx:id="listaTop" styleClass="ranking" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Calidad de datos de personas -->
            <VBox styleClass="tarjeta,grafico" GridPane.rowIndex="2" GridPane.columnIndex="0"
                  GridPane.columnSpan="2">
                <Label text="Datos de contacto de personas" styleClass="grafico-titulo"/>
                <Label text="Porcentaje de registros con informacion de contacto" styleClass="grafico-subtitulo"/>
                <HBox fx:id="medidoresContacto" styleClass="medidores"/>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
